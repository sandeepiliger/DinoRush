<Project Sdk="Microsoft.NET.Sdk">

  <!-- This project is plain .NET and never opened by Unity, so it keeps modern SDK defaults
       (nullable, implicit usings) rather than the Unity-matched settings used by
       ../../src/DinoRush.Core.csproj — see docs/DECISIONS.md D9. -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Output paths are set in Directory.Build.props alongside this file, not here — see
         src/Directory.Build.props for why (MSB3539 ordering). -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.6.0" />
    <PackageReference Include="NUnit" Version="3.13.3" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.2.1" />
    <PackageReference Include="NUnit.Analyzers" Version="3.6.1" />
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/DinoRush.Core.csproj" />
  </ItemGroup>

</Project>
