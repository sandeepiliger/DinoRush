# Normalize line endings for everything text-based. The primary dev machine is Windows;
# without this, Unity's YAML (scenes/prefabs/assets) and C# sources churn CRLF vs LF on every
# save and turn every diff illegible.
* text=auto eol=lf

# C# sources: always LF, never let a tool re-introduce CRLF.
*.cs text eol=lf
*.cginc text eol=lf
*.shader text eol=lf
*.hlsl text eol=lf

# Unity YAML-based assets: treat as text so they diff/merge line-by-line, but be aware that
# scenes/prefabs are still fragile to merge (see docs/DECISIONS.md D12) — this only makes
# diffs readable, it does not make conflicts safe to resolve blindly.
*.unity text eol=lf merge=unityyamlmerge
*.prefab text eol=lf merge=unityyamlmerge
*.asset text eol=lf merge=unityyamlmerge
*.meta text eol=lf merge=unityyamlmerge
*.mat text eol=lf merge=unityyamlmerge
*.physicsMaterial2D text eol=lf merge=unityyamlmerge
*.controller text eol=lf merge=unityyamlmerge
*.anim text eol=lf merge=unityyamlmerge

# Config/data
*.json text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf

# Binary assets — never text-normalize these.
*.png binary
*.jpg binary
*.jpeg binary
*.psd binary
*.tga binary
*.tif binary
*.gif binary
*.fbx binary
*.blend binary
*.mp3 binary
*.wav binary
*.ogg binary
*.ttf binary
*.otf binary
*.dll binary
*.so binary
*.dylib binary

# NOTE on the unityyamlmerge driver above: it is not auto-configured by this file alone.
# On the machine that will actually merge scenes/prefabs, run once:
#   git config merge.unityyamlmerge.driver "'<path-to-Unity-Editor>/Data/Tools/UnityYAMLMerge' merge -p %O %A %B %A"
#   git config merge.unityyamlmerge.name "Unity smart merge"
# Documented in docs/SETUP.md.
